# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizza-palette?retryWrites=true&w=majority

# Authentication & Hashing
JWT_SECRET=your_jwt_secret
SALT=10

# Superadmin & System Alerts
SUPERADMIN_EMAIL=admin@example.com

# Email Configuration (Nodemailer / SMTP)
NODEMAILER_SMTP_HOST=smtp.zoho.com
NODEMAILER_SMTP_PORT=465
NODEMAILER_SMTP_SECURE=true
NODEMAILER_SMTP_EMAIL=your_email@example.com
NODEMAILER_SMTP_PASSWORD=your_email_password

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
